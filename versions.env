# Horizon : tag GitHub « nightly » uniquement (pas de release stable pour l'instant).
# Quand une vraie stable sortira, on changera ça ici + le default du Dockerfile.
HORIZON_GIT_REF=nightly

# Révision de *cette* image Docker (Dockerfile, entrypoint, compose…) sans changer Horizon.
# Tag image : nightly-r<IMAGE_REVISION>  ex. nightly-r1
IMAGE_REVISION=2
