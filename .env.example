# cp .env.example .env — HORIZON_RESOURCES required (horizon-prepare 26.3 output).

HORIZON_RESOURCES=

# GHCR tag: nightly (latest) or nightly-<sha7>-r<N> (run `just tags`)
# HORIZON_IMAGE=nightly

# --- First start (horizon-server init) ---
HORIZON_EULA=true
HORIZON_WORLD=world
HORIZON_SEED=
HORIZON_PORT=25565
HORIZON_WHITELIST=true
HORIZON_PLAYERS=
HORIZON_OP=
HORIZON_ONLINE=true

# --- server.toml (applied on each container start) ---
# HORIZON_MOTD=My Horizon server
# HORIZON_MAX_PLAYERS=20
# HORIZON_PANEL=true
# HORIZON_PANEL_BIND=0.0.0.0:8130
# HORIZON_PANEL_PUBLISH=127.0.0.1:8130:8130
# HORIZON_CONFIG=properties.spawn-protection=16
