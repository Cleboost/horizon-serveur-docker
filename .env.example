# Copier vers .env — HORIZON_RESOURCES obligatoire (dossier 26.3 préparé avec horizon-prepare).

HORIZON_RESOURCES=

# --- Init (1er démarrage, lus par horizon-server init) ---
HORIZON_EULA=true
HORIZON_WORLD=world
HORIZON_SEED=
HORIZON_PORT=25565
HORIZON_WHITELIST=true
HORIZON_PLAYERS=
HORIZON_OP=
HORIZON_ONLINE=true

# --- server.toml (réappliqué à chaque démarrage du conteneur) ---
# HORIZON_MOTD=Mon serveur Horizon
# HORIZON_MAX_PLAYERS=20
# HORIZON_BIND=
# HORIZON_VIEW_DISTANCE=10
# HORIZON_SIMULATION_DISTANCE=10
# HORIZON_ENFORCE_WHITELIST=false
# HORIZON_GAME_MODE=survival
# HORIZON_DIFFICULTY=easy
# HORIZON_ENGINE_LOW_MEMORY=false
# HORIZON_BACKUPS_EVERY=6h
# HORIZON_BACKUPS_KEEP=12

# Panel web (désactivé par défaut dans l'image Docker)
# HORIZON_PANEL=true
# HORIZON_PANEL_BIND=0.0.0.0:8130
# HORIZON_PANEL_ALLOW_PUBLIC=true
# Publier le panel sur l'hôte (sinon seulement docker exec … horizon-server panel)
# HORIZON_PANEL_PUBLISH=127.0.0.1:8130:8130

# Clés supplémentaires : server.motd=… world.seed=… (espaces → guillemets dans .env)
# HORIZON_CONFIG=properties.spawn-protection=16
